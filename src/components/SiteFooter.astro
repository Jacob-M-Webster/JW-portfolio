---
import { getSite } from '../lib/content';
import { POSTERS_READY, QUAD_VISIBLE } from '../lib/scene';

interface Props {
  /** The page shows the sensor viewport, so "drawn for this page" is true. */
  hasViewport?: boolean;
}

const { hasViewport = false } = Astro.props;
const site = await getSite();
const showIllustrations = hasViewport && POSTERS_READY && QUAD_VISIBLE;
---

<footer class="site-footer" id="contact">
  <div class="page">
    <ul role="list">
      <li>
        <a href={`mailto:${site.email}`}>Email {site.email}</a>
      </li>
      <li>
        <a href={site.linkedin} rel="noopener">
          LinkedIn
        </a>
      </li>
      <li>
        <a href={site.github} rel="noopener">
          GitHub
        </a>
      </li>
      <li>
        <a href={site.resume}>Resume (PDF)</a>
      </li>
    </ul>
    <p class="small site-footer-line">
      {showIllustrations ? `${site.footer} ${site.footerIllustrations}` : site.footer}
    </p>
  </div>
</footer>
