---
// The sensor viewport frame. The poster is real markup so it shows with
// JavaScript off; Stage 2 ships flat placeholders (empty SVGs at the
// posters' sizes, so the panel's --viewport fill is the rectangle in both
// themes) and Stage 3 swaps in the rendered posters. The caption arrives
// with them, once it is true. The canvas (Stage 4) goes in the same panel.

// The legend describes points colored by height. Over an empty placeholder
// that would be false, so production omits it until Stage 3 sets this; the
// dev server shows it so the layout can be reviewed.
const POSTERS_READY = false;
const showLegend = POSTERS_READY || import.meta.env.DEV;
---

<figure class="viewport">
  <div class="viewport-panel">
    <img
      class="viewport-poster"
      src="/posters/poster-car-1600.svg"
      srcset="/posters/poster-car-800.svg 800w, /posters/poster-car-1600.svg 1600w"
      sizes="(min-width: 1280px) 900px, (min-width: 1024px) 536px, 100vw"
      width="1600"
      height="1200"
      alt=""
      decoding="async"
    />
    {showLegend && (
      <div class="viewport-legend small">
        <p>Color shows height.</p>
        <p class="viewport-legend-scale">
          Low
          <span class="viewport-legend-bar" aria-hidden="true">
            <span />
            <span />
            <span />
          </span>
          High
        </p>
      </div>
    )}
  </div>
</figure>
