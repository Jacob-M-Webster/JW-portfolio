---
// The sensor viewport frame. The poster is real markup so it shows with
// JavaScript off: the car point cloud rendered by scripts/render_poster.py
// onto each theme's --viewport, in AVIF and WebP at three widths. The canvas
// (Stage 4) goes in the same panel.
import { getSite } from '../lib/content';
import { POSTERS_READY } from '../lib/scene';

const site = await getSite();
const WIDTHS = [800, 1600, 2000];
const DARK = '(prefers-color-scheme: dark)';
const srcset = (theme: string, ext: string) =>
  WIDTHS.map((w) => `/posters/poster-car-${theme}-${w}.${ext} ${w}w`).join(', ');
// Panel width: one gutter-inset column below 1024, at most 536 from 1024, and
// from 1280 the bleed (at most 896; about half the window).
const sizes = '(min-width: 1280px) min(896px, 50vw), (min-width: 1024px) 536px, 92vw';
---

<figure class="viewport">
  <div class="viewport-panel">
    <picture>
      <source media={DARK} type="image/avif" srcset={srcset('dark', 'avif')} sizes={sizes} />
      <source media={DARK} type="image/webp" srcset={srcset('dark', 'webp')} sizes={sizes} />
      <source type="image/avif" srcset={srcset('light', 'avif')} sizes={sizes} />
      <img
        class="viewport-poster"
        src="/posters/poster-car-light-800.webp"
        srcset={srcset('light', 'webp')}
        sizes={sizes}
        width="1600"
        height="1200"
        alt=""
        decoding="async"
      />
    </picture>
    {POSTERS_READY && (
      <div class="viewport-legend small">
        <p>Color shows height.</p>
        <p class="viewport-legend-scale">
          Low
          <span class="viewport-legend-bar" aria-hidden="true">
            <span />
            <span />
            <span />
          </span>
          High
        </p>
      </div>
    )}
  </div>
  {POSTERS_READY && <figcaption class="small viewport-caption">{site.sceneCaption}</figcaption>}
</figure>
