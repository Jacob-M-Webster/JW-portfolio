---
import BaseLayout from '../layouts/BaseLayout.astro';
import ActionLink from '../components/ActionLink.astro';
import ViewportFrame from '../components/ViewportFrame.astro';
import { getSite } from '../lib/content';

const site = await getSite();
---

<BaseLayout title="Jacob Webster: perception and autonomy software">
  <div class="page home-grid">
    <section class="section hero" aria-labelledby="hero-title">
      <h1 id="hero-title">I build perception and autonomy software.</h1>
      <p>
        I'm a computer science senior at the University of South Carolina, graduating in May 2027. I
        enjoy building software for machines that move. I'm looking for new grad software
        engineering roles in autonomy and infrastructure.
      </p>
      <div class="actions">
        <ActionLink href={site.resume} variant="primary">
          Download resume (PDF)
        </ActionLink>
        <ActionLink href={`mailto:${site.email}`} variant="secondary">
          Email me
        </ActionLink>
      </div>
    </section>
    <ViewportFrame />
  </div>
</BaseLayout>
